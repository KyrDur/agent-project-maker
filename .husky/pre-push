#!/usr/bin/env sh

# Pre-push gate — backend pytest + frontend vitest must both be green before
# code leaves the laptop. Without this, frontend test debt accumulates silently
# (47 commits between two "批量修正" rounds shipped 67 failing tests in the
# past — see HANDOFF for the analysis). pnpm lint + pnpm build do NOT catch
# rendering regressions.
#
# 确需跳过时使用 ``git push --no-verify``（例如推送 WIP 分支）。
# 准备合并到 main 的 PR 分支禁止跳过。

set -e

ROOT="$(git rev-parse --show-toplevel)"
GIT_LOCAL_ENV_VARS="$(git rev-parse --local-env-vars)"
# Git emits one trusted variable name per line; word splitting is intentional.
unset $GIT_LOCAL_ENV_VARS

PYTEST_BASETEMP="$(mktemp -d "${TMPDIR:-/tmp}/moldy-pre-push-pytest.XXXXXX")"
cleanup_pytest_basetemp() {
  rm -rf -- "$PYTEST_BASETEMP"
}
trap cleanup_pytest_basetemp EXIT

echo "▶ backend pytest"
cd "$ROOT/backend"
uv run --locked --extra dev pytest tests/ -q --tb=line "--basetemp=$PYTEST_BASETEMP"

echo ""
echo "▶ frontend vitest"
cd "$ROOT/frontend"
# pnpm 9.15+ treats `--run` as a pnpm option unless it follows `--`; without the
# separator the gate dies with "Unknown option: 'run'" before vitest even starts.
pnpm test -- --run --reporter=dot

echo ""
echo "✓ pre-push gate passed"
