# Copy to .env.production on the server; chmod 600. Never commit that file.
# Replace every CHANGE_ME / YOUR_DOMAIN value before startup.
POSTGRES_USER=agent_project
POSTGRES_DB=agent_project
# Use a random hexadecimal password (URL-safe; no escaping needed in DB URLs).
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
ENCRYPTION_KEYS=CHANGE_ME_64_HEX_CHARACTERS
JWT_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_KEY_HASH_SECRET=CHANGE_ME_ANOTHER_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Origin only, no trailing slash and NO /api suffix. Inlined at image build time.
PUBLIC_ORIGIN=https://YOUR_DOMAIN
# Images built outside the production host, for its Linux CPU architecture.
# Use immutable release tags or registry digests, not latest.
BACKEND_IMAGE=agent-project-backend:7aa8a5e
FRONTEND_IMAGE=agent-project-frontend:7aa8a5e
# No shared model-provider keys. Users configure their own keys in Credentials.
